# ── Backend Environment Variables ──
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

DB_PASSWORD=your-database-password-here
DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres
JWT_SECRET=your-64-char-hex-secret-here

# PayPal Subscription Configuration
# Get sandbox credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_SECRET=your-paypal-sandbox-secret

# Dodo Payments Configuration
# Get credentials from https://app.dodopayments.com → Developer → API Keys
DODO_API_KEY=your-dodo-api-key-here
DODO_WEBHOOK_SECRET=your-dodo-webhook-secret-here
DODO_BASE_URL=https://test.dodopayments.com
DODO_STANDARD_PRODUCT_ID=your-standard-product-id
DODO_PREMIUM_PRODUCT_ID=your-premium-product-id

# Email dispatch (Make.com webhook automation)
# Default is already hardcoded — only override if you use a different webhook URL
# MAKE_WEBHOOK_URL=https://hook.us2.make.com/de6b44skd6sdvg65x9magqvbxjfyx8za

# OpenRouter API (multi-LLM provider — GPT-4o, Claude, etc.)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Optional default shared by scripts, visual scenes, and calendars.
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-chat

# Production overrides (optional)
# APP_CORS_ORIGINS=https://yourdomain.com

# ── Admin Panel ──
# Comma-separated list of admin email addresses
ADMIN_EMAILS=muslimforever833@gmail.com

# ── ElevenLabs Voice Generation (Paid Add-On) ──
# Get your API key from https://elevenlabs.io → Profile + API key
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# Base URL (default: https://api.elevenlabs.io)
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# ── Voice Pack Product (Dodo Payments One-Time Purchase) ──
# Create a one-time product at ₹800 in your Dodo dashboard, then paste the product_id
DODO_VOICE_PACK_PRODUCT_ID=your-voice-pack-product-id

# ── Voice Audio Storage ──
# Directory where generated audio files are stored on the server
# VOICE_AUDIO_DIR=./voice-audio

# ── Feature Flag ──
# Set to false to disable voice generation without redeploying
# VOICE_FEATURE_ENABLED=true
